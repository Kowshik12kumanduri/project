# Supabase Configuration (Optional: The application includes a persistent local adapter
# with rich pre-seeded Indian fintech data if Supabase keys are not yet configured)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI Service Configuration (Optional: The application includes a built-in deterministic
# financial analysis & advisory engine if no external API key is supplied)
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
